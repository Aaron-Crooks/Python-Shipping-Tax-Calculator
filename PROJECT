# Product Information Function
def getProductInfo():

# The Product Info List
    productInfo = []
    moreProducts = True
    
# While Loop for Product Info Function
    while moreProducts == True:

# Input for Item Quantity
        itemQuantity = int(input('Enter quantity (enter 0 if done): '))

        if itemQuantity == 0:
            moreProducts = False
        else:
            
# Input for Item Weight
            itemWeight = float(input('Enter item weight: '))

# Input for Item Price
            itemPrice = float(input('Enter cost of item: '))
            print()

# Append the Variables to the List 
            productInfo.append([itemQuantity, itemWeight, itemPrice])
            
    return productInfo

# The Calcultation Function
def calculate(productList):
    boxWeight = 0
    subTotal = 0

    for mainIndex in range(len(productList)):
        itemQuantity, itemWeight, itemPrice = productList[mainIndex]

        boxWeight = boxWeight + (itemQuantity * itemWeight)
        subTotal = subTotal + (itemQuantity * itemPrice)

# Calculate The Shipping
    shipping = boxWeight * .25

# Assign Handling Cost
    if boxWeight < 10:
        handling = 1
    elif boxWeight > 100:
        handling = 5
    else:
        handling = 3

    shippingHandling = shipping + handling

    return subTotal, shippingHandling

